! osmo-stp configuration for the Hamiltel custom core.
!
! This file is a TEMPLATE. docker/stp/entrypoint.sh renders it at container
! start into /etc/osmocom/osmo-stp.generated.cfg using values from .env, so no
! point code or route is ever committed here.
!
! Instance: ${STP_INSTANCE_ID}
! Local point code: ${STP_LOCAL_PC}   Network indicator: ${STP_NI}
! Lab/mock point codes are the default; a real deployment sets STP_LOCAL_PC,
! STP_REMOTE_PCS and (optionally) STP_ROUTES in .env.

line vty
 no login

cs7-instance 0
 point-code ${STP_LOCAL_PC}
 network-indicator ${STP_NI}

! Local ASP (Application Server Process) - binds to all interfaces
asp core-stp-asp ${STP_LOCAL_PORT} 0 m3ua
 local-ip ${STP_LOCAL_IP}
 local-port ${STP_LOCAL_PORT}
 remote-ip ${STP_REMOTE_IP}
 remote-port ${STP_LOCAL_PORT}
 sctp-role ${STP_ASP_MODE}
 sctp-streams 16
 asp! 0

! M3UA Application Server (from tbl_m3ua_as / tbl_m3ua_asp)
as core-stp-as m3ua
 routing-context 1
 traffic-mode loadshare
 asp core-stp-asp
 as! core-stp-as

! Routes are generated by docker/stp/entrypoint.sh:
!   STP_ROUTES (multi-line, explicit) wins when set; otherwise one
!   dpc/opc pair per point code in STP_REMOTE_PCS, then a default route.
${STP_ROUTES}

log file /var/log/osmocom/osmo-stp.log
log level info
log timestamp
