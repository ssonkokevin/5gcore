# 5G Core Engine Environment
# Copy to .env and adjust before building

# General
CORE_NETWORK_SUBNET=10.1.13.0/24
CORE_HOSTNAME_PREFIX=srg
CORE_DOMAIN=core.local

# Database (MariaDB)
DB_HOST=db
DB_PORT=3306
DB_ROOT_PASSWORD=123456
DB_USER=net5gc
DB_PASSWORD=net5gc
DB_NAME=srg_db

# Redis (DRA/SCP cache)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=123456

# STP (osmo-stp / sigtran)
STP_HOST=stp
STP_M3UA_PORT=2905
STP_SCTP_PORT=2905
STP_STREAM=1
STP_AS_NAME=core_stp_as
STP_ROUTE_MODE=redundant

# DRA (Diameter Routing Agent)
DRA_HOST=dra
DRA_PORT=3868
DRA_REALM=core.local
DRA_ORIGIN_HOST=dra.core.local
DRA_ORIGIN_REALM=core.local
DRA_PRODUCT_NAME=SRG-DRA
DRA_VENDOR_ID=10415

# SCP (CAMEL/INAP Service Control Plane)
SCP_HOST=scp
SCP_PORT=3868
SCP_REALM=core.local
SCP_ORIGIN_HOST=scp.core.local
SCP_ORIGIN_REALM=core.local
SCP_CAMEL_PORT=2905

# UDM (Unified Data Management)
UDM_HOST=udm
UDM_PORT=8080
UDM_REALM=core.local
UDM_DB_NAME=hssdb
UDM_DB_USER=hss
UDM_DB_PASSWORD=hss123

# OAM (Observability / Management)
OAM_HOST=oam
OAM_PORT=8081
OAM_USER=admin
OAM_PASSWORD=admin123

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
