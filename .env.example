# Hamiltel custom core — environment template.
#
#   cp .env.example .env
#   chmod 600 .env
#   replace every "change-me" before the host is reachable by anyone else
#
# Compose reads this file for ${VAR} substitution only. Services do not
# inherit it wholesale; each value is passed explicitly in docker-compose.yml,
# and every service has a safe default so the stack boots without this file.
#
# Host-port register lives in docker-compose.yml. Container ports here
# (DIAMETER_PORT, MAP_PORT, OCS_PORT, SCP_PORT) stay at their 3GPP defaults;
# only the published host port moves. See the "Host ports" block below.

# ---------------------------------------------------------------------------
# Host ports
# ---------------------------------------------------------------------------
# Change only the published host port; the container listener keeps its
# protocol default. On a shared host (10.44.44.121 already uses 3306, 8081,
# 8082, 3000 and 9090) set the affected values here — no compose edit needed.
# scripts/preflight.sh lists every port below and says which are in use.
DB_HOST_PORT=3306
HSSDB_HOST_PORT=3307
REDIS_HOST_PORT=6379
MONGO_HOST_PORT=27017
NRF_HOST_PORT=8000
STP_HOST_PORT=2905
MAP_HOST_PORT=2906
CAMEL_HOST_PORT=2907
DRA_HOST_PORT=3868
OCS_HOST_PORT=3870
SCP_HOST_PORT=3871
SCP_SCTP_HOST_PORT=2908
DIAMETER_HOST_PORT=3880
HSS_HOST_PORT=8090
CUSTOM_UDM_HOST_PORT=8007
UDR_HOST_PORT=8006
PCF_HOST_PORT=8004
PCF_GX_HOST_PORT=3873
PCF_GY_HOST_PORT=3874
SMF_HOST_PORT=8002
SMF_PFCP_HOST_PORT=8806
UPF_GTPU_HOST_PORT=2152
UPF_PFCP_HOST_PORT=8805
UPF_MGMT_HOST_PORT=42050
AMF_HOST_PORT=8001
LMF_HOST_PORT=8003
MME_SLG_HOST_PORT=3875
MME_HTTP_HOST_PORT=8075
ESMLC_SLS_HOST_PORT=9082
OAM_HOST_PORT=8081
OAM_FRONTEND_PORT=3001
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000

# free5GC reference profile only (docker compose --profile free5gc)
F5G_NRF_HOST_PORT=18000
F5G_AMF_HOST_PORT=18080
F5G_AMF_N2_HOST_PORT=38413
F5G_SMF_HOST_PORT=18081
F5G_SMF_PFCP_HOST_PORT=18085
F5G_UPF_GTPU_HOST_PORT=18152
F5G_UPF_PFCP_HOST_PORT=18086
F5G_AUSF_HOST_PORT=18082
F5G_UDM_HOST_PORT=18083
F5G_PCF_HOST_PORT=18084
F5G_CHF_HOST_PORT=18087

# ---------------------------------------------------------------------------
# Identity and PLMN
# ---------------------------------------------------------------------------
PLMN_MCC=641
PLMN_MNC=020
CORE_DOMAIN=core.local
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Databases
# ---------------------------------------------------------------------------
DB_HOST=db
DB_PORT=3306
DB_ROOT_PASSWORD=change-me
DB_USER=net5gc
DB_PASSWORD=change-me
DB_NAME=srg_db

HSS_DB_HOST=hssdb
HSS_DB_PORT=3306
HSS_DB_USER=hss
HSS_DB_PASSWORD=change-me
HSS_DB_NAME=hssdb

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me

MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change-me

# ---------------------------------------------------------------------------
# NRF (custom, TS 29.510)
# ---------------------------------------------------------------------------
CUSTOM_NRF_PORT=8000
NRF_HEARTBEAT_TIMER=30

# ---------------------------------------------------------------------------
# STP / DRA / SCP
# ---------------------------------------------------------------------------
STP_INSTANCE_ID=srg01
# Lab/mock point codes. Replace all three with the operator's assigned codes
# before connecting to a live SS7 network; never commit real ones.
STP_LOCAL_PC=1.2.3
STP_NI=natl
STP_ASP_MODE=server
STP_LOCAL_IP=0.0.0.0
STP_LOCAL_PORT=2905
STP_REMOTE_IP=0.0.0.0
# Space-separated adjacent point codes; one dpc/opc route pair is generated per
# entry (mock HLR 1.2.4, mock MSC 1.2.5).
STP_REMOTE_PCS=1.2.4 1.2.5
# Optional explicit route block, newline-separated, e.g.
#   STP_ROUTES=route 1.2.4 1.2.3 3 0 as core-stp-as
# Leave empty to generate routes from STP_REMOTE_PCS. Quote multi-line values.
STP_ROUTES=

DRA_INSTANCE_ID=srg01
DRA_PORT=3868
DRA_REALM=core.local
DRA_ORIGIN_HOST=dra.core.local
DRA_ORIGIN_REALM=core.local
DRA_PRODUCT_NAME=Hamiltel-DRA
DRA_VENDOR_ID=10415
DRA_PEER_CONFIG=/app/config/dra.json

SCP_HOST=scp
SCP_PORT=3869
SCP_REALM=core.local
SCP_ORIGIN_HOST=scp.core.local
SCP_ORIGIN_REALM=core.local
SCP_CAMEL_PORT=2905

# ---------------------------------------------------------------------------
# Diameter S6a/Cx (published on host 3880) and MAP/SCCP (host 2906)
# ---------------------------------------------------------------------------
DIAMETER_ORIGIN_HOST=hss.core.local
DIAMETER_ORIGIN_REALM=core.local
DIAMETER_VENDOR_ID=10415
DIAMETER_PRODUCT_NAME=5G-Core-HSS
DIAMETER_PORT=3868
# MCC+MNC used for KASME when the MME sends no Visited-PLMN-Id. Lab only.
DIAMETER_SERVING_PLMN=00101

MAP_POINT_CODE=3142
MAP_SSN_MAP=6
MAP_GT_MAP=208010000000000
MAP_PORT=2905

# ---------------------------------------------------------------------------
# HSS / UDM / tri-mode subscriber data
# ---------------------------------------------------------------------------
HSS_HOST=hss
HSS_PORT=8090
HSS_NF_INSTANCE_ID=hss-01
HSS_PLMN_MCC=641
HSS_PLMN_MNC=020
HSS_IMSI_START=641020000000000
HSS_IMSI_END=641029999999999
HSS_GROUP_ID=hss-group-1

# Vector ownership (TS 23.632 L.4):
#   1 = credentials in EPS-UDR, vectors in HSS
#   2 = credentials in 5GS-UDR, vectors in UDM (default for this build)
#   3 = split (5G in UDM, EPS/IMS in HSS)
AUTH_OPTION=2
SQN_SERIALIZATION=redis

# Host-side port is 8007; the container listens on 8080.
CUSTOM_UDM_PORT=8080
# 32 hex characters. Replacing this key re-provisions OPc for every OP-based SIM.
# A per-deployment secret: put it in your local .env or a secrets store, never
# in a committed file. Do not add a placeholder here.
OPERATOR_KEY=

# UDR (Nudr_DataRepository, TS 29.504). Owns the authentication subscription
# and SQN; the UDM reaches it at custom-udr:8006. UDR_HOST_PORT in the host
# ports block is the published port. Provisioning still writes tbl_subscriber
# through the UDM, so run the UDR in the same stack as the UDM.
UDR_NF_INSTANCE_ID=udr-01
UDR_PUBLIC_HOST=udr.core.local

# SUCI de-concealment (TS 33.501 Annex C). Profiles A/B need the home network
# private key as 32 hex bytes. Leaving these empty makes the UDM answer 500
# SUCI_KEY_NOT_CONFIGURED for Profile A/B SUCIs; it never guesses.
# Option 1: full JSON array, highest precedence.
#   SUCI_PROFILES=[{"pkid":1,"scheme":1,"private_key":"<64 hex>"}]
# Option 2: one key per scheme.
SUCI_PROFILES=
SUCI_PROFILE_A_PRIVATE_KEY=
SUCI_PROFILE_A_PKID=1
SUCI_PROFILE_B_PRIVATE_KEY=
SUCI_PROFILE_B_PKID=2

# ---------------------------------------------------------------------------
# Custom SMF / UPF / PCF
# ---------------------------------------------------------------------------
SMF_HOST=custom-smf
SMF_PORT=7777
SMF_REALM=core.local
SMF_DNN=internet
SMF_UE_SUBNET=10.60.0.0/16
PFCP_PORT=8805

UPF_HOST=custom-upf
N3_UPF_ADDR=10.11.0.7
N6_UPF_ADDR=10.0.0.5
GTPU_PORT=2152
DATA_PATH_MODE=kernel
DPDK_ENABLED=false
DPI_ENABLED=false
CGNAT_ENABLED=true
UPF_MAX_SESSION=5000
UPF_MAX_THREAD_NUM=3
UPF_MAX_QUEUE_SIZE=8192

PCF_HOST=custom-pcf
PCF_PORT=7777
PCF_REALM=core.local
PCF_ORIGIN_HOST=pcf.core.local
GX_PORT=3870
GY_PORT=3871
PCRFDB_URI=sqlite:///app/pcrf.db

# ---------------------------------------------------------------------------
# free5GC reference profile (docker compose --profile free5gc ...)
# ---------------------------------------------------------------------------
DNS_PRIMARY=8.8.8.8
DNS_SECONDARY=8.8.4.4
SUBNET_POOL=10.60.0.0/16

# ---------------------------------------------------------------------------
# Location services
# ---------------------------------------------------------------------------
# The GMLC is a separate Java/Spring service (github.com/ssonkokevin/gmlc). The
# AMF only needs its SBI base URL to deliver Ngmlc_Location event notifications.
GMLC_SBI_URL=http://gmlc:8082
# The E-SMLC (SLs, LCS-AP) is the lab simulator esmlc-sim in this stack. The
# real E-SMLC replaces the service and the MME's peer address below.
ESMLC_ADDR=esmlc-sim
ESMLC_PORT=9082
ESMLC_BIND_ADDR=0.0.0.0
# SLs transport. "tcp" is the length-framed lab carrier (DECISIONS.md D5);
# SCTP is implemented but unverified because this host has no AF_SCTP.
ESMLC_CARRIER=tcp
MME_SLS_CARRIER=tcp
# How long the simulator waits for the UE's LPP answer before it gives up.
ESMLC_LPP_TIMEOUT=3.0
LMF_PORT=8090

# ---------------------------------------------------------------------------
# Custom AMF / LMF / MME (service-based side; see GET /scope on each service)
# ---------------------------------------------------------------------------
# Service-based side only; see GET /scope on each service. AMF_PORT, LMF_PORT,
# MME_SLG_PORT and MME_HTTP_PORT are now container listener ports fixed in the
# compose file; their published host ports are AMF_HOST_PORT, LMF_HOST_PORT,
# MME_SLG_HOST_PORT and MME_HTTP_HOST_PORT in the "Host ports" block.
AMF_PUBLIC_HOST=amf.core.local
# Optional: advertise a fixed container IP in the NRF profile.
AMF_IPV4=
AMF_LMF_TIMEOUT=5
AMF_DISCOVERY_TTL=10

LMF_PUBLIC_HOST=lmf.core.local
LMF_IPV4=
# Measurement source for Nlmf_Location. Empty means every request answers
# 501 NO_POSITIONING_SOURCE. The endpoint must return
# {"latitude": .., "longitude": .., "accuracy": ..}.
LMF_PROVIDER_URL=
LMF_PROVIDER_TOKEN=
LMF_PROVIDER_TIMEOUT=8

# MME is SLg-only: Diameter PLR is answered 5012, there is no S1AP/S11/S6a.
MME_ORIGIN_HOST=mme.core.local
MME_ORIGIN_REALM=core.local
MME_PRODUCT_NAME=Hamiltel-MME

# ---------------------------------------------------------------------------
# OAM / observability
# ---------------------------------------------------------------------------
OAM_HOST=oam
OAM_PORT=8081
OAM_USER=admin
OAM_PASSWORD=change-me
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=False
GRAFANA_PASSWORD=change-me

# ---------------------------------------------------------------------------
# OCS / Gy (RFC 4006)
# ---------------------------------------------------------------------------
OCS_ORIGIN_HOST=ocs.core.local
OCS_ORIGIN_REALM=core.local
OCS_VENDOR_ID=10415
OCS_PRODUCT_NAME=5G-Core-OCS
OCS_PORT=3869
OCS_FAILURE_HANDLING=2
OCS_SESSION_TIMEOUT=300

# ---------------------------------------------------------------------------
# CAMEL
# ---------------------------------------------------------------------------
CAMEL_GSM_SCF_ADDRESS=scf.core.local
CAMEL_DEFAULT_PHASE=3
