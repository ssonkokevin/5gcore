# 5G Core Engine Environment
# Copy to .env and adjust before building. Sanitize secrets before commit/sharing.

# General
CORE_NETWORK_SUBNET=10.1.13.0/24
CORE_HOSTNAME_PREFIX=srg
CORE_DOMAIN=core.local
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database (MariaDB)
DB_HOST=db
DB_PORT=3306
DB_ROOT_PASSWORD=change-me
DB_USER=net5gc
DB_PASSWORD=change-me
DB_NAME=srg_db

# HSSDB (Tri-Mode UDM: 5G/4G/3G/2G)
HSS_DB_HOST=hssdb
HSS_DB_PORT=3306
HSS_DB_USER=hss
HSS_DB_PASSWORD=change-me
HSS_DB_NAME=hssdb

# Redis (DRA/SCP/PCF cache)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# MongoDB (free5GC NFs)
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change-me

# ========================================================================
# STP/DRA Layer (SS7/SIGTRAN + Diameter)
# ========================================================================
# osmo-stp (STP)
STP_INSTANCE_ID=srg01
STP_LOCAL_PC=3.14.4
STP_NI=natl
STP_ASP_MODE=server
STP_LOCAL_IP=0.0.0.0
STP_LOCAL_PORT=2905
STP_REMOTE_PCS=

# Open5GS DRA (Diameter Routing Agent)
DRA_INSTANCE_ID=srg01
DRA_PORT=3868
DRA_REALM=core.local
DRA_ORIGIN_HOST=dra.core.local
DRA_ORIGIN_REALM=core.local
DRA_PRODUCT_NAME=Open5GS-DRA
DRA_VENDOR_ID=10415
DRA_PEER_CONFIG=/app/config/dra.json

# SCP (CAMEL/INAP Service Control Plane)
SCP_HOST=scp
SCP_PORT=3869
SCP_REALM=core.local
SCP_ORIGIN_HOST=scp.core.local
SCP_ORIGIN_REALM=core.local
SCP_CAMEL_PORT=2906

# ========================================================================
# 5GC Control Plane (free5GC)
# ========================================================================
# NRF
NRF_ADDR=nrf
NRF_PORT=8000

# AMF
AMF_ADDR=amf
AMF_PORT=80
GUAMI_PLMN_MCC=001
GUAMI_PLMN_MNC=01
GUAMI_REGION_ID=1
GUAMI_SET_ID=1
TAI_PLMN_MCC=001
TAI_PLMN_MNC=01
TAI_TAC=1
PLMN_SUPPORT_0_MCC=001
PLMN_SUPPORT_0_MNC=01
PLMN_SUPPORT_0_TAC=1
N2_INTERFACE_AMF_ADDR=amf
N2_INTERFACE_AMF_PORT=38412
N2_INTERFACE_GNB_ADDR=gnb
N2_INTERFACE_GNB_PORT=38412

# SMF (free5GC)
SMF_ADDR=smf
SMF_PORT=80
UPF_ADDR=upf
UPF_PORT=8805
DNS_PRIMARY=8.8.8.8
DNS_SECONDARY=8.8.4.4
SUBNET_POOL=10.60.0.0/16

# UPF (free5GC)
UPF_ADDR=upf
UPF_PORT=8805
N3_INTERFACE_UPF_ADDR=upf
N3_INTERFACE_UPF_PORT=2152
N4_INTERFACE_UPF_ADDR=upf
N4_INTERFACE_UPF_PORT=8805
N4_INTERFACE_SMF_ADDR=smf
N4_INTERFACE_SMF_PORT=8805

# AUSF
AUSF_ADDR=ausf
AUSF_PORT=80

# UDM (free5GC)
UDM_ADDR=udm
UDM_PORT=80

# Custom UDM (Tri-Mode + Batch Upload)
CUSTOM_UDM_HOST=custom-udm
CUSTOM_UDM_PORT=8080

# PCF (free5GC)
PCF_ADDR=pcf
PCF_PORT=80

# CHF
CHF_ADDR=chf
CHF_PORT=80

# ========================================================================
# Custom PCF/SMF/UPF (Engine Scaffolds)
# ========================================================================
PCF_HOST=custom-pcf
PCF_PORT=7777
PCF_REALM=core.local
PCF_ORIGIN_HOST=pcf.core.local
GX_PORT=3870
GY_PORT=3871
PCRFDB_URI=sqlite:///app/pcrf.db

SMF_HOST=custom-smf
SMF_PORT=7778
SMF_REALM=core.local
SMF_DNN=internet
SMF_UE_SUBNET=10.60.0.0/16
N4_SMF_UPF_ADDR=upf
PFCP_PORT=8805

UPF_HOST=custom-upf
N3_UPF_ADDR=10.11.0.7
N6_UPF_ADDR=10.0.0.5
GTPU_PORT=2152
DATA_PATH_MODE=kernel
DPDK_ENABLED=false
DPI_ENABLED=false
CGNAT_ENABLED=true
UPF_MAX_SESSION=5000
UPF_MAX_THREAD_NUM=3
UPF_MAX_QUEUE_SIZE=8192

# ========================================================================
# Location services
# ========================================================================
# The GMLC is a separate service in github.com/ssonkokevin/gmlc. The AMF only
# needs its SBI base URL to deliver Ngmlc_Location event notifications.
GMLC_SBI_URL=http://gmlc:8082
# E-SMLC (SLs, LCS-AP over SIGTRAN) and LMF (Nlmf_Location) run here.
ESMLC_HOST=esmlc
ESMLC_PORT=9082
ESMLC_SCTP_PORT=9082
LMF_PORT=8090
MME_SLG_PORT=3868
MME_SLS_PORT=9082

# ========================================================================
# OAM (Observability / Management)
# ========================================================================
OAM_HOST=oam
OAM_PORT=8081
OAM_USER=admin
OAM_PASSWORD=change-me
DJANGO_SECRET_KEY=change-me-in-production

# UDM Crypto (Milenage/OPc)
# ========================================================================
# Operator key is a per-deployment secret. It belongs in your local .env or a
# secrets store, never in a committed file; do not add a placeholder here.
OPERATOR_KEY=

# ========================================================================
# Diameter S6a/Cx Server (HSS/HLR Interworking)
# ========================================================================
DIAMETER_ORIGIN_HOST=hss.core.local
DIAMETER_ORIGIN_REALM=core.local
DIAMETER_VENDOR_ID=10415
DIAMETER_PRODUCT_NAME=5G-Core-HSS
DIAMETER_PORT=3868

# ========================================================================
# MAP/SCCP Stack (2G/3G HLR Interworking)
# ========================================================================
MAP_POINT_CODE=3142
MAP_SSN_MAP=6
MAP_GT_MAP=208010000000000
MAP_PORT=2905

# ========================================================================
# CAMEL State Machine (SCP/CAMEL Call Control)
# ========================================================================
CAMEL_GSM_SCF_ADDRESS=scf.core.local
CAMEL_DEFAULT_PHASE=3

# ========================================================================
# OCS/Gy Client (Online Charging System - RFC 4006)
# ========================================================================
OCS_ORIGIN_HOST=ocs.core.local
OCS_ORIGIN_REALM=core.local
OCS_VENDOR_ID=10415
OCS_PRODUCT_NAME=5G-Core-OCS
OCS_PORT=3869
OCS_FAILURE_HANDLING=2
OCS_SESSION_TIMEOUT=300
